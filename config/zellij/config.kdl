// Zellij tuned for Ghostty, Neovim, and OpenCode.
theme "nord"
default_layout "compact"
default_shell "fish"
// default_mode "locked"

pane_frames true
mouse_mode true
copy_on_select true
copy_clipboard "system"
scroll_buffer_size 10000
simplified_ui false
styled_underlines true
show_startup_tips false
show_release_notes false
session_serialization true
pane_viewport_serialization true
scrollback_lines_to_serialize 100
serialization_interval 60
stacked_resize true

ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

// Alt navigation stays out of Neovim's Ctrl-h/j/k/l path.
keybinds {
    normal {
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt n" { NewPane; }
        bind "Alt z" { ToggleFocusFullscreen; }
        bind "Alt t" { NewTab; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
    }
    shared_except "locked" {
        // Ghostty rewrites Option-Left/Right into ESC b / ESC f before zellij
        // sees them, so "Alt Right" never arrives and Alt f is what actually
        // has to stay free for the shell's forward-word. Fullscreen moved to
        // Alt z. These unbinds must live here, not at the keybinds root: the
        // defaults declare Alt f / Alt Right inside shared_except "locked",
        // and a root-level unbind does not reach them.
        unbind "Alt f"
        unbind "Alt Right"

        // Command palette (github.com/rashidalnaemi/zellij-commandpalette).
        // Alt p instead of Ctrl k: Ctrl-k is Neovim/fish territory.
        bind "Alt p" {
            LaunchOrFocusPlugin "file:~/.config/zellij/plugins/zellij-commandpalette.wasm" {
                floating true
                move_to_focused_tab true
            }
        }
    }
}
