layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }

    tab name="editor" {
        pane command="nvim"
    }

    tab name="terminal" focus=true split_direction="vertical" {
        pane name="shell"
    }

    tab name="git" {
        pane command="lazygit"
    }
}
